pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        cron('H 3 * * 0')
    }

    environment {
        DEPLOY_DIR = '/opt/mirizoom'
    }

    stages {
        stage('Run Law Batch') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'mirizoom-ec2-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    ),
                    string(
                        credentialsId: 'mirizoom-app-host',
                        variable: 'APP_HOST'
                    )
                ]) {
                    sh '''
                        set -eu

                        SSH_TARGET="$SSH_USER@$APP_HOST"

                        ssh \
                            -o BatchMode=yes \
                            -o ConnectTimeout=10 \
                            -o StrictHostKeyChecking=yes \
                            -i "$SSH_KEY" \
                            "$SSH_TARGET" \
                            "
                                set -eu
                                cd '$DEPLOY_DIR'

                                test -f app.env
                                test -f docker-compose.backend.yml
                                command -v flock >/dev/null
                                mkdir -p batch-data

                                flock -n /tmp/mirizoom-law-batch.lock \\
                                    docker compose \\
                                        --profile batch \\
                                        --env-file app.env \\
                                        -f docker-compose.backend.yml \\
                                        run --rm --no-deps batch
                            "
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '주간 세법 Batch가 완료되었습니다.'
        }

        failure {
            echo '주간 세법 Batch 실행에 실패했습니다. Console Output을 확인하세요.'
        }
    }
}
